# ==============================================================================
# FLYTOHUB — VARIÁVEIS DE AMBIENTE (SUPABASE & SEGURANÇA)
# ==============================================================================
# INSTRUÇÕES:
# 1. Crie um arquivo com o nome exato: .env.local
# 2. Copie o conteúdo abaixo para o .env.local e insira as credenciais do seu projeto Supabase
# 3. O arquivo .env.local está bloqueado no .gitignore e JAMAIS será enviado para o GitHub,
#    garantindo que suas chaves e dados de clientes nunca vazem.
# ==============================================================================

# URL do Projeto Supabase (Ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Pública Anônima (Anon Key / Public Key)
# ATENÇÃO: NUNCA use a chave "service_role" no front-end! Apenas a "anon" key.
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
